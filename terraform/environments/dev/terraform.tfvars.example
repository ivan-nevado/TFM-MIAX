# Copy to terraform.tfvars (git-ignored) and adjust. No secrets or account ids belong here.
region             = "eu-west-1"
alarm_emails       = []
monthly_budget_usd = 50

# Small sizes for development
batch_max_vcpus   = 32
api_desired_count = 1

# Optional: CI role for GitHub Actions (requires the account's GitHub OIDC provider)
# github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
# github_repository        = "<owner>/<repository>"
