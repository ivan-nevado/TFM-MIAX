# Copy to terraform.tfvars (git-ignored) and adjust. No secrets or account ids belong here.
region             = "eu-west-1"
alarm_emails       = []
monthly_budget_usd = 50

# Training on Spot. The account's Spot quota is 5 vCPUs (EC2 quota L-34B43A08), so one 4-vCPU
# instance runs one job at a time. After a quota increase, raise batch_max_vcpus (for example to
# 32) and the array children run in parallel; nothing else changes.
batch_max_vcpus      = 4
batch_job_vcpus      = 4
batch_job_memory_mib = 14000
batch_instance_types = ["m6i.xlarge", "m6a.xlarge", "m5.xlarge", "m5a.xlarge", "r6i.xlarge", "r5.xlarge"]

# API
api_desired_count = 0 # 0 = API stopped; set to 1 for a demo

# Optional: CI role for GitHub Actions (requires the account's GitHub OIDC provider)
# github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
# github_repository        = "<owner>/<repository>"

# Images are pushed with a dated tag: the repositories are immutable, so "latest" cannot be reused
training_image_tag = "20261116"
api_image_tag      = "20261115"
