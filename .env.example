# Copy to .env (git-ignored). No secrets are needed to run the replication.

# --- pipeline -------------------------------------------------------------------------------
# RELVAL_ROOT=            # repository root; only needed when running outside the repository
# RELVAL_N_JOBS=-1        # parallel workers over months (-1 = all cores)

# --- backend (prefix RELVAL_, see backend/app/core/settings.py) --------------------------------
RELVAL_DATA_ROOT=../data            # local folder or s3://bucket/prefix
RELVAL_REPORTS_ROOT=../reports      # local folder or s3://bucket/prefix
RELVAL_RUN_NAME=replication
RELVAL_SOURCE=lseg
RELVAL_HEADLINE_SEED=20230301
RELVAL_CORS_ORIGINS=["http://localhost:5173"]
RELVAL_LOG_LEVEL=INFO

# --- frontend (frontend/.env) -------------------------------------------------------------------
# VITE_API_BASE_URL=      # empty = same origin (Vite proxy, nginx or CloudFront)
